# AI Tech Consultant - Environment Configuration
# Optional: Set your Claude (Anthropic) or OpenAI API keys below.
# If not provided, the system seamlessly operates with its built-in high-fidelity local embedding and reasoning engines.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Task 1: Knowledge Brain Settings
KNOWLEDGE_BRAIN_HOST=127.0.0.1
KNOWLEDGE_BRAIN_PORT=8000
KNOWLEDGE_BRAIN_URL=http://127.0.0.1:8000
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
MAX_CRAWL_PAGES=25
CRAWL_DELAY_SECONDS=0.5

# Task 2: Inbox Agent Settings
INBOX_AGENT_PORT=3000
CONSECUTIVE_APPROVAL_THRESHOLD=20

# Task 3: Meeting to Scope Settings
DEFAULT_HOURLY_RATE=120
DEFAULT_CURRENCY=USD
